# Copy to .env and fill in. .env is gitignored - keep it that way.

# ------------------------------------------------------------------ GeeLark
# From the GeeLark dashboard: API settings -> open API credentials.
GEELARK_APP_ID=
GEELARK_API_KEY=

# ------------------------------------------------------------------- sx.org
# Optional. With it, a build that is refused by an exit address asks sx.org for
# a new one on the proxy it already has - three a day per proxy - instead of
# spending another proxy. Needs the Proxy tab's `Port ID` column filled in;
# without either, the build just takes the next proxy.
SXORG_API_KEY=

# ------------------------------------------------------------ Google Sheets
# One spreadsheet with four tabs: Gmails, Proxy and Gpt Info are the pools a
# build draws from, and Phones is what it writes back. Those names are fixed;
# only the id below points at them.
#
# Share the sheet with the service account's email address as an Editor.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json

# -------------------------------------------------------------- phone specs
# region: cn | sgp | us   (us only offers Android 15)
GEELARK_REGION=sgp
GEELARK_ANDROID=Android 15
# Prefix for created phones; the row number is appended.
PHONE_NAME_PREFIX=farm

# ------------------------------------------------------------- target app
# Deep-linked by package id, so no Play Store text search and no risk of
# installing a clone.
TARGET_PACKAGE=com.openai.chatgpt

# ------------------------------------------------------------------ limits
# Billing is per running minute, so every budget here is also a spend cap.
#
# How many phones are worked on at once. Raising this shortens the wall clock,
# not the bill:
# three phones for five minutes costs the same as three phones one after another.
# Concurrency is across phones - one RPA task per phone is a hard API limit - and
# every worker draws from the same API rate budget below, so more workers means
# more waiting at the limiter, never a ban. Override per run with --workers.
MAX_CONCURRENT_PHONES=1

# The outer bound on how long one phone may be worked on, and so on what it can
# cost. It wins: each step below gets whichever is smaller, its own budget or
# the time left. One phone may work through several Gmails and several app
# accounts - that is the point - so this covers more than one pass.
BUILD_BUDGET_SECONDS=3600

# CapSolver, for the reCAPTCHA image grid Google sometimes shows at sign-in.
# Empty (the default) leaves a captcha fatal, exactly as before. With a key,
# the flow tries the grid through CapSolver and gives up once one sign-in
# has been stopped by CAPTCHA_MAX_ATTEMPTS separate captchas, so it can
# never loop or drain the balance. Separate captchas, not rounds: Google's
# 3x3 draws fresh tiles as they are answered and takes three to six rounds
# to pass, and those are all one captcha.
# CAPSOLVER_KEY=
# CAPTCHA_MAX_ATTEMPTS=3

# Apps GeeLark's own app center carries (Spotify) go in through its installer,
# ordered the moment the phone is up and left to land during the Google
# sign-in, instead of through the Play Store screens - the slow half of a
# build. 0 walks Play for every app, as before. ChatGPT is not in the center
# and walks Play either way.
# APP_INSTALL_API=1

# The login-rate work (2026-09-10). Measured over a week of 624 Google
# sign-ins: every address that ever signed in carried an authenticator key;
# the first address on a phone signed in 73 times in 100 and the fifth never;
# some phone models GeeLark hands out sign in one time in ten, some exit
# hosts one in five.
# One Gmail per phone: after an address Google distrusted (captcha, verify
# your phone, could not verify) the phone is deleted and the next address goes
# on a fresh phone and exit. 0 restores the old rule - up to five addresses on
# one phone.
# ONE_GMAIL_PER_PHONE=1
# Models a phone is deleted and made again for, before an address is spent on
# it - substrings of "brand model", comma-separated; empty for none. Up to
# MODEL_RETRIES times, then the phone is kept whatever it is.
# BAD_MODELS=vivo V2362A,Redmi 2311DRK48C,OPPO PKT110,Xiaomi 2410DPN6CC
# MODEL_RETRIES=3
# The host gate: an exit host whose sign-ins over the last week fall under
# HOST_GATE_RATE (with at least HOST_GATE_MIN of them) has its free exits set
# aside as suspect until it recovers.
# HOST_GATE_MIN=5
# HOST_GATE_RATE=0.5

LOGIN_BUDGET_SECONDS=900
INSTALL_BUDGET_SECONDS=600
# Signing into the app itself, after it is installed. Only spent on rows that
# carry app credentials; a row without them stops after the install.
APP_LOGIN_BUDGET_SECONDS=600

# How long a claim on a Gmail, an exit or an app account may go unrefreshed
# before the sync puts it back. A run restamps what it holds every minute, so a
# stamp that has stopped moving means the run that took it is gone.
#
# Defaults to 300 - five missed beats. It used to default to
# BUILD_BUDGET_SECONDS, which was the answer that was safe before the refresh
# existed; an hour of an app account sitting unusable after one interrupted
# run is what that cost.
#
# Put it back up to the build budget the moment anything that does NOT refresh
# claims against this sheet - an older checkout on a laptop is enough. A window
# shorter than a live holder's silence hands that holder's row to somebody
# else mid-build.
# STALE_CLAIM_SECONDS=3600

# GeeLark allows 200 requests/min; exceeding it bans the key for 2 hours.
# Keep headroom - this is enforced centrally by the API client.
API_REQUESTS_PER_MINUTE=120

# ---------------------------------------------------------------- local dirs
STATE_DIR=./state
ARTIFACT_DIR=./artifacts
# Every invocation appends to logs/<date>-<machine>.log at DEBUG, whatever
# LOG_LEVEL says - the console is for watching, the file is for finding out
# what happened on the other machine yesterday.
LOG_DIR=./logs
LOG_LEVEL=INFO

# How the log FILE is written - the console is always prose. `json` gives one
# object per line, each carrying which machine and which commit wrote it, plus
# any numbers the line was logged with. That is what something else can count
# and raise an alarm on; `grep -c` over prose breaks the day a sentence is
# rephrased. Leave it as text on a laptop, where the file is read by hand.
# LOG_FORMAT=json

# Whether a pass hands its work to a worker pool instead of waiting for it.
#
# Off by default. With it on, the sheet keeps moving through a ten-minute
# build and an account pasted in is picked up on the next pass rather than
# when the current job happens to end. It also means several batches can be
# in flight at once, which every invariant in the loop was written without -
# so it is a thing to turn on deliberately, and off again in one line.
SERVE_CONCURRENT=0

# How many batches may be in flight at once when the pass hands its work
# off - a batch being what one pass or one Send ordered, which runs its own
# jobs in parallel. So this bounds overlapping passes, not phones: phones
# are MAX_CONCURRENT_PHONES. 0 is the old shape: the pass runs its own batch
# and is as long as its longest job. SERVE_CONCURRENT=1 with no count means
# 4. The control lane's logins run on the same pool (B-2, B-3, 2026-09-08).
SERVE_WORKERS=0

# Type and tap the way a hand does: text in bursts of two to four keys with
# a short pause between, taps at a point inside the control rather than on
# its exact centre, a moment before a form is submitted. Google's sign-in
# page scores the script's cadence - the same accounts through the same
# exits met no captcha by hand and a captcha on thirteen of sixteen phones
# from the builder (2026-09-09). 0 turns it off.
HUMAN_CADENCE=1

# Taps and swipes written into the phone's own touch device with sendevent,
# in the shape the GeeLark viewer's touches have (recorded 2026-09-10: a
# repeated position frame, 55-270 ms of dwell, no pressure, spare release
# frames), instead of `input tap`, which never reaches the kernel and lands
# DOWN and UP in the same instant with a pressure of exactly 1.0. A phone
# whose device cannot be written to falls back to `input tap` on its own.
# 0 turns it off.
# KERNEL_TOUCH=1

# Where the Google sign-in starts. `settings` is Android's own add-account
# entry point; `play` opens Google Play and presses its Sign in - the way
# the operator signs in by hand and meets no challenge, while the builder
# from Settings met captchas and "Verify your phone number" on the same
# phones through the same exits (2026-09-09). Falls back to Settings if
# Play shows no Sign in within 45 seconds.
SIGN_IN_VIA=settings

# Which part of the service this process is. `all` runs the loop and the
# console in one process, as it always did. `web` is the console alone -
# it reads and writes Postgres and nothing else - for a container of its
# own, so a change to a page never restarts a build. `keeper` is the loop
# without the console. compose.yml gives the `web` service ROLE=web itself;
# leave this `all` here (2026-09-09).
ROLE=all

# Phase 4 (2026-09-10). With BUILD_QUEUE=1 the keeper writes each build and
# finish into the `jobs` table instead of running it on its own threads,
# and the `builder` container (compose.yml, ROLE=builder) carries them out
# BUILDER_WORKERS at a time. Off, the keeper builds as it always did.
BUILD_QUEUE=0
BUILDER_WORKERS=4

# Scale-out step 1 (2026-09-10). With LEDGER_IN_PG=1 the phone ledger -
# which phone exists, and which process holds it - lives in the store's
# `phone_claims` table instead of state/ledger.json, so a keeper and any
# number of builders on any host share it. The file is imported once, the
# first time the table is found empty. Off, the file is used as before.
LEDGER_IN_PG=0

# Scale-out steps 2 and 3 (2026-09-10). STATE_IN_PG=1 keeps the breaker's
# count in the store (service_state, key `breaker`) instead of
# state/breaker.json, so a keeper on any host picks up where the last
# stopped. ARTIFACTS_IN_PG=1 mirrors a build's archived screens into the
# store's `artifacts` table when the build ends, so a console on any host
# can show them; the keeper prunes the store's copy after seven days.
STATE_IN_PG=0
ARTIFACTS_IN_PG=0

# Whether this process also keeps a log file under LOG_DIR. compose.yml
# turns it off for builders, which come and go by number; the store's log
# table (LOG_DB) has every line either way.
LOG_FILE=1

# What this machine is called in History rows and log filenames. The hostname
# by default, which is the answer on a laptop. A container is why this can be
# overridden: Docker invents a new hostname on every restart, so the tab would
# fill with names that mean nothing and the log would start a new file each
# time the service came back.
# GEELARK_MACHINE=builder-1

# Which commit this build is. Read out of the checkout by default, which is
# the right answer on a machine that has one - it follows a `git pull` without
# anyone re-running anything. An image built from a copy of the tree has no
# `.git`, so the build stamps it here instead and `geelark --version` keeps
# answering the first question anyone asks about a server.
# GEELARK_REVISION=v0.1.0-4-gabc1234

# How many phones `geelark serve` keeps built to one step short of ready -
# signed into Google with the app installed, waiting only for a GPT account.
# A delivery is then one login away, about four minutes, instead of a whole
# build. Each one holds a profile slot until it is delivered, so this number
# and the plan's slot count bound each other.
WARM_STOCK=10

# How long `geelark serve` waits between passes.
SERVE_INTERVAL_SECONDS=30

# --- The Postgres store (stage 1 of the sheet retirement) -------------------
# Off by default. While off, the `store` package is never even imported, so
# these four can stay unset on any box that has not opted in.
# STORE_ENABLED=0
# STORE_HOST=your-cluster.db.example.ir
# STORE_PORT=5432
# STORE_DB=gfarm
# STORE_USER=gfarm
# The password lives here and nowhere else - never in the repo.
# STORE_PASSWORD=

# The read-only web UI (stage 3 of the sheet retirement). Loopback only -
# reach it through an ssh tunnel: ssh -L 8787:127.0.0.1:8787 <server>.
# WEB_ENABLED=1
# WEB_PORT=8787
# In Docker this must be 0.0.0.0 - the compose publish pins the host side
# to 127.0.0.1, which is what keeps it private.
# WEB_BIND=127.0.0.1
# The zone the console shows its clocks in (the store keeps UTC).
# WEB_TZ=Asia/Tehran
# Stage 5: lets the web queue commands (the actions table) and lets the
# serve pass drain and execute them. Off = the read-only web of stage 3.
# WEB_MUTATIONS=0
# C1: the Users page - an admin creating people and ticking what each may
# do. Off = the page does not exist; permissions can only be read.
# WEB_USER_ADMIN=0
# C2: the three pools live in Postgres and the sheet's pool tabs become an
# input funnel. Switch only with the sheet stopped and the last mirror run.
#
# ONE WAY. Turning it back off is not a rollback: the mirror would wake and
# copy the tabs' statuses back over the table, where the importer has
# already written `imported`, and the Phones mirror wakes with it and would
# copy a stale picture over live build state. Every row born in the store
# since the switch - console adds, panel accounts, everything the importer
# made - has no twin on any tab. Going back means a migration, not a flag.
# POOLS_IN_PG=0
# C6: app accounts are logged in on command from the dashboard, not on
# arrival. Off = a pass finishes a warm phone for every waiting account.
# MANUAL_LOGIN=0
# C8: capture INFO-and-up log lines into the store for the Logs page,
# batched off a bounded queue; it switches itself off if the cluster
# stalls. Off = the log file on disk only.
# LOG_DB=0
# C9: the read-only /api/v1 door for the customer panel and the Telegram
# bot, on the same listener as the console, behind a bearer key issued
# per client. Off = those paths are 404 and nothing outside can read.
# WEB_API=0
# C9 stage B: and the writing half of that door - hand the farm an
# account, say a customer is ready, take one back. Needs WEB_API too.
# WEB_API_WRITES=0

# A queued command wakes the service instead of waiting for the top of its
# next pass. Off (the default) means the interval is the only clock, which
# is how this has always run. The row is written either way and the pass
# finds it either way; this decides whether that is in about a second or in
# up to SERVE_INTERVAL_SECONDS. A woken pass still keeps five seconds
# between it and the one before, so a person pressing three buttons in a
# row gets one pass and not three.
# WAKE_ON_ACTION=0

# A second drainer for the commands that are over in seconds - boot a phone,
# test an exit, swap a proxy, tick a control - so they do not stand behind a
# build on the pass's own thread. Off (the default) means the pass drains
# everything, exactly as it always has; the pass drains these too either
# way, so the lane can only get there first, never instead. Needs the store,
# the mutations and the pools in Postgres.
# CONTROL_LANE=0

# The Google workbook is not opened at all. Off (the default) is exactly how
# this has always run. On, stock comes in through the console's paste boxes,
# the pass makes no Sheets call of any kind, and no revoked share or 429 can
# stop the farm. Needs POOLS_IN_PG, and refuses the pair at startup if it is
# missing: with the workbook shut there is nowhere else for the pools to live.
#
# Unlike POOLS_IN_PG this one goes back. Set it to 0 and the next pass opens
# the workbook and drains whatever is sitting in the tabs, because nothing
# writes them while it is on. What is lost meanwhile is only that: a row
# pasted into a tab waits there until it is turned off, or is pasted into the
# console instead.
# SHEET_CLOSED=0
